{
    "name": "gtgt/discogs-api-bundle",
    "type": "symfony-bundle",
    "description": "Symfony Bundle providing a complete API client for Discogs.com v2.0 with OAuth 1.0a support",
    "keywords": ["discogs", "api", "client", "symfony", "bundle", "oauth"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "league/oauth1-client": "^1.11",
        "symfony/cache": "^8.0 || ^7.4",
        "symfony/config": "^8.0 || ^7.4",
        "symfony/dependency-injection": "^8.0 || ^7.4",
        "symfony/event-dispatcher": "^8.0 || ^7.4",
        "symfony/expression-language": "^8.0 || ^7.4",
        "symfony/framework-bundle": "^8.0 || ^7.4",
        "symfony/http-client": "^8.0 || ^7.4",
        "symfony/http-foundation": "^8.0 || ^7.4",
        "symfony/routing": "^8.0 || ^7.4",
        "symfony/serializer": "^8.0 || ^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1.8",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/test-pack": "^1.2.0",
        "symfony/yaml": "^8.0 || ^7.4"
    },
    "autoload": {
        "psr-4": {
            "DiscogsApiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DiscogsApiBundle\\Tests\\": "tests/",
            "Tests\\App\\": "tests/App"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "bundle": true
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
